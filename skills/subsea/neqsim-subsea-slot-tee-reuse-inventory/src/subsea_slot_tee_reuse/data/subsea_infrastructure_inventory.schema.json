{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NeqSim subsea infrastructure inventory",
  "description": "Per-item inventory of tie-in capacity in existing subsea infrastructure: slots, tees, hubs, spare or reusable lines, status, service, size, remaining life, source and verification level.",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "neqsim.subsea_infrastructure_inventory.v1"},
    "host": {"type": "string"},
    "area": {"type": "string"},
    "as_of": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "verification", "source"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"enum": ["host", "template", "manifold", "slot", "tee", "hub", "plet", "plem", "well", "pipeline", "flowline", "riser", "j_tube", "riser_slot", "umbilical", "umbilical_core", "spool", "gas_lift_line", "injection_line", "meg_line", "chemical_line", "cable"]},
          "status": {"enum": ["in_use", "spare", "abandoned", "planned", "unknown"]},
          "service": {"enum": ["oil", "gas", "multiphase", "water_injection", "gas_injection", "gas_lift", "meg", "chemical", "hydraulic", "power", "control", "produced_water", "unknown"]},
          "size_in": {"type": ["number", "null"]},
          "pressure_rating_bar": {"type": ["number", "null"]},
          "length_km": {"type": ["number", "null"]},
          "fluid": {"type": "string"},
          "capacity": {"type": "object", "properties": {"value": {"type": "number"}, "unit": {"type": "string"}}},
          "install_year": {"type": ["number", "null"]},
          "design_life_years": {"type": ["number", "null"]},
          "remaining_life_years": {"type": ["number", "null"]},
          "condition": {"enum": ["good", "fair", "poor", "unknown"]},
          "total_slots": {"type": ["number", "null"]},
          "free_slots": {"type": ["number", "null"]},
          "hub_type": {"type": "string"},
          "position": {"type": "object", "required": ["lat", "lon"], "properties": {"lat": {"type": "number"}, "lon": {"type": "number"}}},
          "connects": {"type": "array", "items": {"type": "string"}},
          "repurpose_option": {"type": "string"},
          "insulated": {"type": "boolean"},
          "source": {"type": "string"},
          "verification": {"enum": ["measured", "documented", "estimated", "unknown"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
