{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trajectory hand-off",
  "description": "Trajectory in (from a trajectory tool or the anti-collision agent) and out (planning geometry for screening).",
  "type": "object",
  "required": [
    "well_id",
    "depth_reference",
    "stations"
  ],
  "properties": {
    "well_id": {
      "type": "string"
    },
    "depth_reference": {
      "type": "string"
    },
    "reference_elevation_msl_m": {
      "type": "number"
    },
    "coordinate_system": {
      "type": "string"
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "md_m",
          "inc_deg",
          "azi_deg"
        ],
        "properties": {
          "md_m": {
            "type": "number"
          },
          "inc_deg": {
            "type": "number"
          },
          "azi_deg": {
            "type": "number"
          },
          "tvd_m": {
            "type": "number"
          },
          "north_m": {
            "type": "number"
          },
          "east_m": {
            "type": "number"
          }
        }
      },
      "minItems": 2
    },
    "uncertainty_model": {
      "type": "string"
    },
    "offset_wells": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "separation_factors": {
      "type": "object"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$id": "iwp_trajectory.v1"
}